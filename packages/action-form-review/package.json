{
    "name": "@elizaos/action-form-review",
    "version": "0.1.0",
    "description": "Form Review Action for VC Accelerator Applications",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "@elizaos/source": "./src/index.ts",
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format esm --dts",
        "dev": "tsup src/index.ts --format esm --dts --watch",
        "lint": "eslint --fix  --cache .",
        "test": "jest"
    },
    "dependencies": {
        "@elizaos/core": "workspace:*"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^20.10.6",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "typescript": "^5.3.3"
    }
}
